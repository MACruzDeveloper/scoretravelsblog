JWT_SECRET= #Your value here
ATLAS_URL= #Your value here

# Google Gemini (Genkit)
GEMINI_API_KEY= #Your Gemini API key from https://aistudio.google.com/apikey

# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER= #SMTP login from Brevo (SMTP & API page)
SMTP_PASS= #SMTP key from Brevo
SMTP_FROM= #Verified sender email
SMTP_TO= #Inbox that receives contact form messages
# Server
NODE_ENV=development
PORT=3040
# Comma separated list of origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the app (e.g. 1 behind nginx). Leave empty locally.
TRUST_PROXY=
# Folder for uploaded images. Defaults to server/uploads/images
UPLOADS_DIR=
# Production database, when ATLAS_URL points to the local one (docker compose up -d). Used to copy it
# (npm run db:dev:copy), to back it up (npm run backup, backup:images) and by users:set-password -- --prod
ATLAS_URL_PROD=
# Public URL of a Vercel Blob store. Set it to keep images there instead of UPLOADS_DIR
# (for hosting without a writable disk, like Vercel). On Vercel the credentials are automatic
BLOB_STORE_URL=
# Only outside Vercel, to write to the store (npm run images:to-blob)
BLOB_READ_WRITE_TOKEN=
# Built client served by the API. Defaults to client/dist
CLIENT_DIST_DIR=
# Public address of the site (e.g. https://midominio.com) for the sitemap and social previews.
# Leave empty to use the host of each request
SITE_URL=
# Log level: trace, debug, info (default), warn, error, fatal or silent
LOG_LEVEL=
