# Copy this file to .env.local and fill in the values (.env.local is not committed)

# API base URL. Leave empty to use http://localhost:3040 locally and the same origin in production
VITE_API_URL=

# Free key for CARTO basemaps (light map style): https://carto.com/basemaps/apikey
# Without it the map falls back to the standard OpenStreetMap style
VITE_CARTO_API_KEY=
