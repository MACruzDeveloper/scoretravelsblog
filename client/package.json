{
  "name": "my-react-ts-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "rundev": "concurrently --names api,web \"npm --prefix ../server run dev\" \"wait-on --timeout 60000 http-get://localhost:3040/api/health && vite\"",
    "build": "tsc && vite build",
    "lint": "eslint src e2e playwright.config.ts --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "test:run": "vitest run",
    "e2e:build": "vite build --mode e2e --outDir e2e/dist --emptyOutDir",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "dompurify": "^3.4.17",
    "i18next": "^26.5.11",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^17.1.9",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.5",
    "sass": "^1.108.2",
    "terser": "^5.51.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
